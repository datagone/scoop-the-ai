// Configure PSScriptAnalyzer settings
{
    "[powershell]": {
        "editor.formatOnSave": true
    },
    "powershell.scriptAnalysis.settingsPath": "PSScriptAnalyzerSettings.psd1",
    "powershell.codeFormatting.preset": "OTBS",
    "powershell.codeFormatting.alignPropertyValuePairs": true,
    "powershell.codeFormatting.ignoreOneLineBlock": true,
    "json.schemas": [
        {
            "url": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
            "fileMatch": [
                "bucket/**/*.json"
            ]
        }
    ],
    "files.insertFinalNewline": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/tmp": true
    },
    "files.trimTrailingWhitespace": true,
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#3ff58037",
        "activityBar.activeBorder": "#15202b",
        "activityBar.background": "#3ff58037",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#9b68f7",
        "activityBarBadge.foreground": "#15202b",
        "activityBarTop.activeBackground": "#3ff58037",
        "activityBarTop.activeBorder": "#15202b",
        "activityBarTop.background": "#3ff58037",
        "activityBarTop.foreground": "#15202b",
        "activityBarTop.inactiveForeground": "#15202b99",
        "commandCenter.border": "#15202b99",
        "commandCenter.foreground": "#15202b",
        "sash.hoverBorder": "#3ff58037",
        "statusBar.background": "#0ef36037",
        "statusBar.debuggingBackground": "#0ef36037",
        "statusBar.debuggingForeground": "#15202b",
        "statusBar.foreground": "#15202b",
        "statusBar.inactiveBackground": "#0ef36037",
        "statusBarItem.hoverBackground": "#0ac44d37",
        "statusBarItem.remoteBackground": "#9b67f7",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#0ef36037",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#0ef36099",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.color": "#0ef36037",
}
